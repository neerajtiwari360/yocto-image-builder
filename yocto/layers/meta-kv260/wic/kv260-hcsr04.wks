# Existing QSPI U-Boot loads boot.scr from the FAT partition.
# Current kernel + script + DTBs total about 24 MB; 32 MiB fits these assets.
part /boot --source bootimg-partition --ondisk mmcblk --fstype=vfat --label boot --active --align 4096 --fixed-size=32M
# Avoid WIC adding another 30% and its default 10 MiB of spare space.
part / --source rootfs --ondisk mmcblk --fstype=ext4 --label root --align 4096 --use-uuid --overhead-factor=1.0 --extra-space=0
bootloader --ptable msdos
