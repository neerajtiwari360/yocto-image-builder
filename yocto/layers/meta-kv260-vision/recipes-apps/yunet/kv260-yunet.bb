SUMMARY = "Optimized native YuNet camera inference for KV260 SmartCam"
LICENSE = "CLOSED"
SRC_URI = "file://runtime.tar.gz;name=runtime file://source-release.json"
# Generated by sync_image.py; do not hand-edit the source pin.
YUNET_SOURCE_SHA256 = "0d301a9689dc9da0f20c24e02a93af321c40dcb7eb8bff0591cc2f4c45cb37e3"
SRC_URI[runtime.sha256sum] = "${YUNET_SOURCE_SHA256}"
do_unpack[prefuncs] += "verify_yunet_archive"
python verify_yunet_archive() {
    import bb.fetch2
    import hashlib
    import json
    from pathlib import Path
    fetcher = bb.fetch2.Fetch(d.getVar('SRC_URI').split(), d)
    archive = Path(fetcher.localpath('file://runtime.tar.gz;name=runtime'))
    sidecar = Path(fetcher.localpath('file://source-release.json'))
    release = json.loads(sidecar.read_text())
    expected = d.getVar('YUNET_SOURCE_SHA256')
    if release.get('schema_version') != 1 or release.get('archive_sha256') != expected or hashlib.sha256(archive.read_bytes()).hexdigest() != expected:
        bb.fatal('YuNet source release checksum mismatch; rerun reviewed source sync')
}
do_configure[prefuncs] += "verify_yunet_source"
python verify_yunet_source() {
    import hashlib
    import json
    from pathlib import Path
    root = Path(d.getVar('S'))
    manifest = json.loads((root / 'SOURCE_RELEASE.json').read_text())
    if manifest.get('schema_version') != 1 or manifest.get('platform_id') != 'kv260-smartcam-b3136-v1':
        bb.fatal('Incompatible YuNet source release')
    for name, expected in manifest['files'].items():
        path = root / name
        if path.is_symlink() or not path.resolve().is_relative_to(root.resolve()) or not path.is_file() or hashlib.sha256(path.read_bytes()).hexdigest() != expected:
            bb.fatal('YuNet source file checksum mismatch: ' + name)
    config = dict(line.split('=', 1) for line in (root / 'config/yunet.conf').read_text().splitlines() if line and not line.startswith('#'))
    if 'recognition_model' in config:
        recognition = json.loads((root / 'model/recognition.json').read_text())
        if recognition.get('fingerprint') != '0x101000016010406' or recognition.get('input') != [1,112,96,3] or recognition.get('output_dimensions') != 512 or recognition.get('dpu_subgraphs') != 1 or recognition.get('cpu_subgraphs') != 0 or recognition.get('preprocess') != 'amd-resnet20-112x96-bgr-q16-minus127.5-div127.5-v1' or hashlib.sha256((root / 'model/recognition.xmodel').read_bytes()).hexdigest() != recognition.get('model_sha256'):
            bb.fatal('Recognition model does not match the native SmartCam DPU contract')
}
S = "${WORKDIR}/runtime"
DEPENDS = "vart xir openssl sqlite3 json-c"
RDEPENDS:${PN} = "kv260-vision-runtime"
inherit cmake pkgconfig systemd
PACKAGECONFIG ??= ""
PACKAGECONFIG[hdmi] = "-DENABLE_HDMI=ON,-DENABLE_HDMI=OFF,libdrm"
PACKAGES =+ "${PN}-hdmi"
SYSTEMD_PACKAGES = "${@bb.utils.contains('PACKAGECONFIG', 'hdmi', '${PN}-hdmi', '', d)}"
SYSTEMD_SERVICE:${PN}-hdmi = "yunet-hdmi.service"
SYSTEMD_AUTO_ENABLE:${PN}-hdmi = "${@'enable' if d.getVar('YUNET_HDMI_AUTOSTART') == '1' else 'disable'}"
RDEPENDS:${PN}-hdmi = "kv260-vision-runtime"
EXTRA_OECMAKE = "-DENABLE_VART=ON -DENABLE_AUTH_DATABASE=ON -DBUILD_TESTING=OFF"
do_configure:prepend() {
    printf '%s  %s\n' '39bb7312515e3fb350676681571152ed6c0a34afaba850a385d69ee01e3f2752' '${S}/model/yunet_smartcam.xmodel' | sha256sum -c -
}
do_install() {
    install -d ${D}/opt/yunet/bin ${D}/opt/yunet/model ${D}/opt/yunet/config
    install -m0755 ${B}/yunet-kv260 ${D}/opt/yunet/bin/
    install -m0644 ${S}/model/yunet_smartcam.xmodel ${D}/opt/yunet/model/
    install -m0644 ${S}/model/manifest.json ${D}/opt/yunet/model/
    if [ -f ${S}/model/recognition.xmodel ]; then
        install -m0644 ${S}/model/recognition.xmodel ${D}/opt/yunet/model/
        install -m0644 ${S}/model/recognition.json ${D}/opt/yunet/model/
    fi
    install -m0644 ${S}/compatibility.json ${D}/opt/yunet/
    install -m0644 ${S}/SOURCE_RELEASE.json ${D}/opt/yunet/
    install -m0644 ${S}/config/yunet.conf ${D}/opt/yunet/config/
    install -m0755 ${S}/scripts/run.sh ${D}/opt/yunet/run.sh
    install -m0755 ${S}/scripts/run-auth.sh ${D}/opt/yunet/run-auth.sh
    install -m0755 ${S}/scripts/run-preview.sh ${D}/opt/yunet/run-preview.sh
    if ${@bb.utils.contains('DISTRO_FEATURES', 'systemd', 'true', 'false', d)}; then
        install -d ${D}${systemd_system_unitdir}
        install -m0644 ${S}/scripts/yunet-inference.service ${D}${systemd_system_unitdir}/
    fi
    if ${@bb.utils.contains('PACKAGECONFIG', 'hdmi', 'true', 'false', d)}; then
        install -d ${D}${systemd_system_unitdir} ${D}${sysconfdir}/default
        install -m0755 ${B}/yunet-hdmi ${D}/opt/yunet/bin/
        install -m0755 ${S}/scripts/hdmi.sh ${D}/opt/yunet/hdmi.sh
        install -m0644 ${S}/config/yunet-hdmi ${D}${sysconfdir}/default/yunet-hdmi
        install -m0644 ${S}/scripts/yunet-hdmi.service ${D}${systemd_system_unitdir}/
    fi
}
FILES:${PN}-hdmi = "/opt/yunet/bin/yunet-hdmi /opt/yunet/hdmi.sh ${systemd_system_unitdir}/yunet-hdmi.service ${sysconfdir}/default/yunet-hdmi"
CONFFILES:${PN}-hdmi = "${sysconfdir}/default/yunet-hdmi"
FILES:${PN} = "/opt/yunet ${systemd_system_unitdir}/yunet-inference.service"
CONFFILES:${PN} = "/opt/yunet/config/yunet.conf"
COMPATIBLE_MACHINE = "kv260-vision"
PACKAGE_ARCH = "${MACHINE_ARCH}"
